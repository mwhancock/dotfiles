window-decoration = false
gtk-titlebar = false

background-opacity = 0.95
background-blur = true
font-family = JetBrainsMono Nerd Font Mono
font-size = 12
window-padding-x = 12
window-padding-y = 12

confirm-close-surface = false

# Touchscreen and trackpad scroll tuning (discrete:1 stops multi-line paging jumps)
mouse-scroll-multiplier = precision:0.5,discrete:1

# `command = /usr/bin/fish` and `theme = noctalia` are deliberately absent:
# /usr/bin/fish does not exist on NixOS, and noctalia is not a nixarchy theme.
# nixarchy's activation appends the runtime theme file (config-file = ...).
